{
  "name": "actstype",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "build:html": "node build-single-file.js"
  },
  "build": {
    "appId": "com.yourcompany.actstype",
    "productName": "ActsType",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "esv.json",
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.8",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.14",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^0.13.5",
    "vitest": "^4.0.17"
  }
}
